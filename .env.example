# -------------------------------------------------------------------
# NEXORA — environment configuration
# Copy this file to .env and fill in real values before running.
# -------------------------------------------------------------------

# Database connection. With the bundled docker-compose this is set for you.
# For an external database, point this at your own PostgreSQL instance.
DATABASE_URL="postgresql://nexora:nexora@db:5432/nexora?schema=public"

# Auth.js session signing secret. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
AUTH_SECRET="replace-with-a-long-random-string"

# Required for real AI task execution (digital employees calling the LLM).
# Without it the app runs, but running a task will fail.
ABACUSAI_API_KEY=""

# Optional — only needed if you enable file uploads to S3-compatible storage.
AWS_REGION=""
AWS_BUCKET_NAME=""
AWS_FOLDER_PREFIX=""

# Set to "true" to seed demo data (demo@nexora.app / demo1234) on first start.
SEED_ON_START="false"
